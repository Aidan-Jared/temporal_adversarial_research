// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "Debugpy",
    "label": "pytest '…esearch/main.py'",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": ["\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "module": "pytest",
  },
  {
    "adapter": "Debugpy",
    "label": "Debug main.py with args",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": [ "--seed",
         "42",
         "--runs",
         "5",
         "--model_config",
         "base",
         "--dataset",
         "cifar100-c",
         "--model",
         "xder",
         "--backbone",
         "resnet18",
         "--severity",
         "1",
         "--poison_task",
         "0",
         "--pcp",
         "0.5",
         "--pp",
         "0.5",
         "--corruptions",
         "gaussian_blur",
         "--buffer_size",
         "500",
         "--constr_margin",
         "0.7",
         "--alpha",
         "0.3",
         "--beta",
         "0.8",
         "--gamma",
         "0.85",
         "--optim_wd",
         "0",
         "--lambd",
         "0.05",
         "--constr_eta",
         "0.001",
         "--lr",
         "0.03",
         "--simclr_temp",
         "5",
         "--optim_mom",
         "0",
         "--simclr_batch_size",
         "64",
         "--simclr_num_aug",
         "2"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "program": "$ZED_WORKTREE_ROOT/main.py",
  },
]
